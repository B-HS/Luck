{
  "name": "lotto-checker",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build:css && bun run --hot server.ts",
    "build:css": "bunx @tailwindcss/cli -i ./ui/globals.css -o ./public/globals.css --minify",
    "build": "bun run build:css && bun run build:vercel",
    "build:vercel": "bun scripts/build-vercel.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run db/seed.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "14.12.3",
    "@tailwindcss/cli": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "feconfig-bhs": "^1.0.7",
    "happy-dom": "14.12.3",
    "tailwindcss": "^4.2.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.5.0"
  }
}
